{
  "name": "felipemiramontesr.net",
  "version": "1.0.0",
  "description": "B. Eng. Felipe de Jesús Miramontes Romero - Personal Website & CV",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint assets/js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "html-validate \"*.html\" \"**/*.html\"",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "vite",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "html-validate": "^10.7.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "assets/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{html,css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
